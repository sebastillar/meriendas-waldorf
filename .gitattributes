# Normalize line endings: repo stores LF; on Windows use core.autocrlf=true so working copy uses CRLF and only real edits show as modified.
* text=auto

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
